<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  engine-guardian 的 launchd 常驻模板（macOS）。

  用法：
    1. 把所有 com.example.engine-guardian 换成你自己的 label（反向域名写法）
    2. 把 /PATH/TO/engine-guardian 换成本文件所在目录的真实绝对路径
    3. 把 /Users/<你的用户名> 换成你的真实家目录
    4. 复制到 ~/Library/LaunchAgents/<你的label>.plist
    5. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<你的label>.plist

  注意：LaunchAgent 没有 ~/Desktop 访问权（Operation not permitted）。
  守护器只读任务台账，所以常驻没问题；被它守护/拉起的服务别放在桌面目录。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.engine-guardian</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/PATH/TO/engine-guardian/guardian.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/PATH/TO/engine-guardian</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/<你的用户名>/.engine-guardian/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/<你的用户名>/.engine-guardian/launchd.err.log</string>
</dict>
</plist>
